# ══════════════════════════════════════════════════════════
#  Bhasha-Agent — .gitignore
# ══════════════════════════════════════════════════════════

# ── Environment Variables ─────────────────────────────────
# Real secrets stay local; *.env.example templates are tracked.
.env
.env.local
.env.*.local

# ── All .md files EXCEPT root README.md ───────────────────
*.md
!/README.md

# ── Python Virtual Environments ───────────────────────────
one/
venv/
env/
.venv/
.Python

# ── Python Cache & Bytecode ───────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# ── Node.js ───────────────────────────────────────────────
node_modules/
.next/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Ingestion pipeline (root) ────────────────────────────
# Still untracked pending the P1.a rewrite, after which it becomes a real
# ingestion service and these entries should be removed so it is versioned.
/batch_scraper.py
/collect_urls_smart.py
/urls_to_scrape.txt
/utils/
/requirements.txt

# ── Quarantined dead code, pending confirmed deletion ────
/_archive/

# ── Scraped Data — entire directory ──────────────────────
# All scraped data (raw, processed, api, spike, logs, JSON dumps).
# Postgres is the canonical store; these are only staging artifacts.
scraped_data/

# ── Data files (JSON, CSV, log) ──────────────────────────
# Ignore all JSON data files globally except frontend config files.
*.json
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/components.json

# Log files
*.log

# ── Harvested credentials cache (x-api-key) ──────────────
/.cache/

# ── Test Outputs ──────────────────────────────────────────
test_*.txt
test_*.png

# ── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.sublime-*
*.code-workspace

# ── Miscellaneous ────────────────────────────────────────
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.vercel
