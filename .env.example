# ══════════════════════════════════════════════════════════
#  Bhasha-Agent — infrastructure settings
#
#  Copy to .env at the repo root. Read by BOTH docker-compose.yml
#  and backend/config.py, so the credentials only exist in one place.
#  Application secrets (API keys) go in backend/.env instead.
# ══════════════════════════════════════════════════════════

# ── Postgres ────────────────────────────────────────────
POSTGRES_USER=bhasha
POSTGRES_PASSWORD=bhasha
POSTGRES_DB=bhasha
POSTGRES_PORT=5432

# ── Qdrant ──────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Leave blank to run Qdrant without auth locally.
QDRANT_API_KEY=
