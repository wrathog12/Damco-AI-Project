# ── Bhasha-Agent Backend ───────────────────────────────
# Copy this file to .env and fill in your API keys.
#
# Where the keys come from:
#   • Deepgram → https://console.deepgram.com          (200 min/month free)
#   • Cartesia → https://play.cartesia.ai/keys         (startup free tier)
#
# Infrastructure settings (POSTGRES_*, QDRANT_PORT) live in the repo-root
# .env instead, because docker-compose.yml reads that same file. So does
# GEMINI_API_KEY, which is the LLM *and* embedding key — see below.

# ── LLM — Google AI (Gemini Flash-Lite) ─────────────────
# No key goes here: the conversation model authenticates with GEMINI_API_KEY
# from the **repo-root** .env, the same key the embeddings use. Groq was dropped
# because gpt-oss-120b answered English questions in Hinglish and the free tier's
# 8,000 tokens/minute could not carry two concurrent callers — see config.py.
#
# Optional overrides (defaults in config.py are the measured-good ones):
#   LLM_MODEL=gemini-3.5-flash-lite
#   LLM_THINKING_LEVEL=minimal

# ── STT — Deepgram ──────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── TTS — Cartesia ──────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key_here

# ── Postgres ────────────────────────────────────────────
# Must match the credentials in the repo-root .env used by docker compose.
DATABASE_URL=postgresql+asyncpg://bhasha:bhasha@localhost:5432/bhasha

# ── Qdrant ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave blank for local docker compose (no auth configured by default).
QDRANT_API_KEY=
QDRANT_COLLECTION=schemes

# ── Auth (used from P3) ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me

# ── Voice transport ─────────────────────────────────────
# smallwebrtc | daily | livekit
TRANSPORT=smallwebrtc

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
