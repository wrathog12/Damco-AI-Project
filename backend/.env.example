# ── Bhasha-Agent Backend ───────────────────────────────
# Copy this file to .env and fill in your API keys.
#
# Where the keys come from:
#   • Deepgram → https://console.deepgram.com          (200 min/month free)
#   • Cartesia → https://play.cartesia.ai/keys         (startup free tier)
#
# Infrastructure settings (POSTGRES_*, QDRANT_PORT) live in the repo-root
# .env instead, because docker-compose.yml reads that same file. So does
# GEMINI_API_KEY, which is the LLM *and* embedding key — see below.

# ── LLM — Google AI (Gemini Flash-Lite) ─────────────────
# No key goes here: the conversation model authenticates with GEMINI_API_KEY
# from the **repo-root** .env, the same key the embeddings use. Groq was dropped
# because gpt-oss-120b answered English questions in Hinglish and the free tier's
# 8,000 tokens/minute could not carry two concurrent callers — see config.py.
#
# Optional overrides (defaults in config.py are the measured-good ones):
#   LLM_MODEL=gemini-3.5-flash-lite
#   LLM_THINKING_LEVEL=minimal

# ── STT — Deepgram ──────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── TTS — Cartesia ──────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key_here

# ── Postgres ────────────────────────────────────────────
# Must match the credentials in the repo-root .env used by docker compose.
DATABASE_URL=postgresql+asyncpg://bhasha:bhasha@localhost:5432/bhasha

# ── Qdrant ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave blank for local docker compose (no auth configured by default).
QDRANT_API_KEY=
QDRANT_COLLECTION=schemes

# ── Auth (used from P3) ─────────────────────────────────
# Signs THREE things: the anonymous identity cookie, the access JWT, and the OTP
# code hashes. Rotating it logs everyone out, resets every anonymous quota and
# invalidates every code in flight. Must be 32+ bytes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me

# ── OTP login ───────────────────────────────────────────
# stub = write the code to the log instead of sending an SMS. The default,
# because every real provider bills per message.
OTP_PROVIDER=stub
# Returns the code in the request-otp HTTP response, so a script can log in.
# Honoured ONLY when OTP_PROVIDER=stub. NEVER set this in a deployment — it makes
# every account takeable by anyone who knows a phone number.
OTP_DEV_ECHO=0
# MSG91 — leave blank until there is credit on an account.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Turn quota ──────────────────────────────────────────
# Anonymous first: no login wall. Login raises the ceiling, it does not open a gate.
ANON_TURN_QUOTA=10
USER_TURN_QUOTA=100
QUOTA_WINDOW_HOURS=24

# ── Profiles and privacy (P3 slice 3) ───────────────────
# Encrypts everything personal at rest: the profile, the transcript bodies and
# the cached eligibility reasons (AES-256-GCM, see auth/crypto.py).
#
# It has NO DEFAULT, unlike JWT_SECRET, and that is the point: with no key set
# nothing personal is stored at all — the agent works exactly as it did in P2 and
# simply has no memory. A weak default would silently make "encrypted at rest"
# untrue while the feature appeared to work.
#
# Deliberately NOT derived from JWT_SECRET. That secret is rotated to log everyone
# out, which is routine; coupling them would make an ordinary rotation destroy
# every profile in the database.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PROFILE_ENCRYPTION_KEY=

# The privacy notice a stored profile was agreed against. Publishing a new notice
# means bumping this, which makes every existing agreement stale and forces the
# consent screen again — so change it when the notice changes, and not otherwise.
CONSENT_VERSION=2026-09-1

# Retention, swept by a background task and by scripts/purge_expired.py.
# Transcripts are short-lived because they are the most sensitive thing stored;
# interactions last longer because a scheme someone looked at last winter is still
# useful context and is not, on its own, sensitive.
CONVERSATION_RETENTION_DAYS=90
INTERACTION_RETENTION_DAYS=365
# An anonymous identity with no phone number and no activity is deleted outright:
# there is nobody who can ask us to, so it has to expire by itself.
ANON_PRUNE_DAYS=90
RETENTION_SWEEP_HOURS=24

# ── Voice transport ─────────────────────────────────────
# smallwebrtc | daily | livekit
TRANSPORT=smallwebrtc

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
