# ── Bhasha-Agent Frontend ───────────────────────────────
# Copy to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at `next build`
# time, not read at runtime — a built image cannot be promoted between
# environments with different backends. Set these before building.

# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Defaults to NEXT_PUBLIC_API_URL with http:// swapped for ws://
# (and https:// for wss://), so you normally do not need to set this.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
